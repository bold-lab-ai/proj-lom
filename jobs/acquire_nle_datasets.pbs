#!/bin/bash -l
# SGE job: convert all NLE datasets on Myriad and rsync to bologna.
#
# Usage: qsub jobs/myriad_nao_convert.sh
#
# Prerequisites (run once on a Myriad login node before submitting):
#   curl -LsSf https://astral.sh/uv/install.sh | sh
#   git clone https://github.com/epignatelli/latent-option-models-code ~/repos/latent-option-models-code
#   mkdir -p ~/repos/latent-option-models-code/logs

# --------------------------------------------------------------------------- #
# SGE directives
# --------------------------------------------------------------------------- #
#$ -S /bin/bash
#$ -l h_rt=48:0:0
#$ -l mem=40G
#$ -pe smp 32
#$ -ac allow=B
#$ -l tmpfs=50G
#$ -N nle_convert
#$ -o logs/nle_convert.out
#$ -j y
#$ -cwd

# --------------------------------------------------------------------------- #
# CONFIGURATION — edit before submitting
# --------------------------------------------------------------------------- #
DEST_BASE="$USER@bologna.ee.ucl.ac.uk:/scratch/$USER/lom/datasets"
WORKERS=28
LOCAL_DIR="/dev/shm/lom_$$"
CODE_DIR="$HOME/repos/latent-option-models-code"

# --------------------------------------------------------------------------- #
# Environment
# --------------------------------------------------------------------------- #
export PATH="$HOME/.local/bin:$PATH"
cd "$CODE_DIR"
# Conversion needs no torch: skip it and its CUDA libraries.
uv sync --frozen --no-dev --no-install-project \
    --no-install-package torch \
    --no-install-package cuda-toolkit \
    --no-install-package cuda-bindings \
    --no-install-package nvidia-cudnn-cu12 \
    --no-install-package nvidia-cusparselt-cu12 \
    --no-install-package nvidia-nccl-cu12 \
    --no-install-package nvidia-nvjitlink-cu12 \
    --no-install-package nvidia-nvshmem-cu12 \
    --no-install-package triton
source "$CODE_DIR/.venv/bin/activate"

mkdir -p logs
OUTPUT_DIR="$LOCAL_DIR"
echo "OUTPUT_DIR=$OUTPUT_DIR"

# Background monitor — logs CPU/RAM/net every 60s to logs/monitor.log
(while true; do
    echo "=== $(date) ==="
    free -h
    top -b -n 1 -u "$USER" | grep -E "top|PID|python"
    awk 'NR>2 {printf "%-10s rx:%s tx:%s\n",$1,$2,$10}' /proc/net/dev
    echo ""
    sleep 60
done) >> logs/monitor.log 2>&1 &
MONITOR_PID=$!
trap "kill $MONITOR_PID 2>/dev/null" EXIT

run_dataset() {
    local dataset=$1
    local npz_subdir=$2
    local dest=$3
    local skip_db_flag=${4:-}
    local npz_dir="$OUTPUT_DIR/nle/$npz_subdir"

    echo "[$(date)] [$dataset] Starting..."
    python -u "$CODE_DIR/scripts/prepare_data.py" "$dataset" \
        --raw-dir    "$LOCAL_DIR" \
        --output-dir "$OUTPUT_DIR" \
        --log-dir    "$CODE_DIR/logs" \
        --workers    "$WORKERS" \
        $skip_db_flag

    echo "[$(date)] [$dataset] Rsyncing to $dest..."
    ssh "${DEST_BASE%%:*}" "mkdir -p '${dest#*:}'"
    rsync -avz --progress "$npz_dir/" "$dest/"

    echo "[$(date)] [$dataset] Cleaning up local data..."
    rm -rf "${LOCAL_DIR:?}/nle/${npz_subdir}"
    rm -rf "${LOCAL_DIR:?}/${dataset}" "${LOCAL_DIR:?}/zips/${dataset}" "${LOCAL_DIR:?}/${dataset}.db"

    echo "[$(date)] [$dataset] Done."
}

# --------------------------------------------------------------------------- #
# Run all datasets
# --------------------------------------------------------------------------- #
run_dataset "nao-top10" "nao-top10" "$DEST_BASE/nle/nao-top10"
run_dataset "nld-aa"    "aa"        "$DEST_BASE/nle/aa"        "--skip-db"
run_dataset "nld-nao"   "nao"        "$DEST_BASE/nle/nao"       "--skip-db"

echo "[$(date)] All datasets done."
